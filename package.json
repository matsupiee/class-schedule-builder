{
  "name": "class-schedule-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "preview": "turbo run preview",
    "deploy": "turbo run deploy",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "prisma:generate": "turbo run prisma:generate",
    "db:migrate:new": "pnpm --filter @packages/db db:migrate:new",
    "db:apply:local": "pnpm --filter @packages/web db:apply:local",
    "db:apply:remote": "pnpm --filter @packages/web db:apply:remote"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5"
  }
}
